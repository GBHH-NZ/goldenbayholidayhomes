# Site (also set as GitHub Actions *variable* NEXT_PUBLIC_SITE_URL)
NEXT_PUBLIC_SITE_URL=https://www.goldenbayholidayhomes.com

# Optional — only for project Pages at https://<user>.github.io/<repo>/
# Also set as GitHub Actions variable BASE_PATH (workflow maps it to NEXT_PUBLIC_BASE_PATH)
NEXT_PUBLIC_BASE_PATH=

# Guesty Booking Engine API — read-only catalogue sync (npm run sync:guesty)
# In GitHub: add as repository *secrets* GUESTY_CLIENT_ID / GUESTY_CLIENT_SECRET
# See .github/SECRETS.md
GUESTY_CLIENT_ID=
GUESTY_CLIENT_SECRET=
GUESTY_API_BASE=https://booking-api.guesty.com
