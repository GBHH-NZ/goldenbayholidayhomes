# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# scrape caches (regenerate with npm run scrape:wix-images)
content/.wix-*

# Guesty bookings sync Chrome profile
.tmp-guesty-chrome-profile/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
