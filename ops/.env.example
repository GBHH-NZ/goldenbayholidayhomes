# Backend: mock (default) | firebase
VITE_DATA_BACKEND=mock

# App base path (must match vite base). Local default /ops/
# On GitHub Pages project site: /goldenbayholidayhomes/ops/
# VITE_BASE_PATH=/ops/

# --- Firebase (set when project is ready; also add as GitHub Actions secrets) ---
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_DATABASE_URL=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Future: Google Apps Script web app URL for calendar / email
# VITE_APPS_SCRIPT_URL=
